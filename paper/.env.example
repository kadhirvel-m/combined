# Core app
APP_ENV=development
API_DOCS_ENABLED=true

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_REF=

# Auth/Cookies
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_REFRESH_HASH_SECRET=replace_me
AUTH_TOKEN_ISSUER=
AUTH_TOKEN_AUDIENCE=authenticated

# Cloudflare Turnstile
CLOUDFLARE_SITE_KEY=
CLOUDFLARE_SECRET_KEY=
TURNSTILE_USE_TEST_KEYS=true

# AI providers (optional)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Print security
PRINT_OTP_HASH_SECRET=replace_me
PRINT_OTP_TTL_SECONDS=900
PRINT_OTP_RESEND_COOLDOWN_SECONDS=60
