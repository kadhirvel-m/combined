# ============================================================
#  PaperX – Environment Configuration Template
#  Copy this file to .env and fill in your own values.
#  NEVER commit the filled-in .env file to source control.
# ============================================================

# ----- AI / LLM -------------------------------------------------
OPENAI_API_KEY=sk-...your-openai-key...
GEMINI_API_KEY=AIza...your-gemini-key...
OPENROUTER_API_KEY=sk-or-v1-...your-openrouter-key...
LLM_MODEL=gpt-4o-mini

# ----- Search ---------------------------------------------------
SERPAPI_API_KEY=...your-serpapi-key...

# ----- Supabase -------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Use ONLY the anon/public key for the service client that handles
# user-facing requests. Never expose the service_role key to the
# front-end or commit it to source control.
SUPABASE_ANON_KEY=eyJ...your-anon-key...
# Service role key grants unrestricted DB access – keep it secret.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...
SUPABASE_BUCKET=profile

# ----- Google Cloud / Storage -----------------------------------
# Path to your downloaded service-account JSON key file.
# Do NOT commit the key file itself; add it to .gitignore.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account_key.json

# ----- YouTube --------------------------------------------------
YT_API_KEY=AIza...your-youtube-api-key...

# ----- Cloudflare Turnstile -------------------------------------
CLOUDFLARE_SITE_KEY=0x...your-site-key...
CLOUDFLARE_SECRET_KEY=0x...your-secret-key...
TURNSTILE_USE_TEST_KEYS=false

# ----- Auth cookies / tokens ------------------------------------
AUTH_ACCESS_COOKIE_NAME=paperx_at
AUTH_REFRESH_COOKIE_NAME=paperx_rt
AUTH_STATE_COOKIE_NAME=paperx_auth
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
# AUTH_COOKIE_DOMAIN=.paperx.tech
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
# Must be set to a long random string in production:
AUTH_REFRESH_HASH_SECRET=...generate-with-openssl-rand-hex-32...
PRINT_OTP_HASH_SECRET=...generate-with-openssl-rand-hex-32...

# ----- Rate limits (tuneable) -----------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX_REQUESTS=240
RATE_LIMIT_LOGIN_MAX_REQUESTS=12
RATE_LIMIT_AI_MAX_REQUESTS=20

# ----- App env --------------------------------------------------
APP_ENV=production
