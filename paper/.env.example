# PaperX Environment Configuration
# Copy this file to .env and fill in actual values.
# NEVER commit the real .env file to version control.

# ──────────────────────────────────────────────────────────────────────────────
# OpenAI
# ──────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ──────────────────────────────────────────────────────────────────────────────
# SerpAPI (search)
# ──────────────────────────────────────────────────────────────────────────────
SERPAPI_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Google / Gemini
# ──────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Additional keys for rotation / load balancing (optional)
# GEMINI_API_KEY1=
# GEMINI_API_KEY3=
# GEMINI_API_KEY4=

# Path to the Google Cloud service account JSON file (do NOT commit the file)
GOOGLE_APPLICATION_CREDENTIALS=service_account_key.json

# ──────────────────────────────────────────────────────────────────────────────
# OpenRouter
# ──────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# ──────────────────────────────────────────────────────────────────────────────
# LLM Model selection
# ──────────────────────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────────────────────────────────────
# Supabase
# ──────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_BUCKET=profile

# ──────────────────────────────────────────────────────────────────────────────
# YouTube Data API
# ──────────────────────────────────────────────────────────────────────────────
YT_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (CAPTCHA)
# ──────────────────────────────────────────────────────────────────────────────
CLOUDFLARE_SITE_KEY=
CLOUDFLARE_SECRET_KEY=
# Set to true only in local development to use Cloudflare test keys
TURNSTILE_USE_TEST_KEYS=false

# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────
APP_ENV=production

# ──────────────────────────────────────────────────────────────────────────────
# Auth / Cookie configuration
# ──────────────────────────────────────────────────────────────────────────────
AUTH_ACCESS_COOKIE_NAME=paperx_at
AUTH_REFRESH_COOKIE_NAME=paperx_rt
AUTH_STATE_COOKIE_NAME=paperx_auth
# AUTH_COOKIE_DOMAIN=paperx.tech   # set in production
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_ROTATION_TABLE=auth_refresh_tokens

# REQUIRED: set a strong random value (e.g. `openssl rand -hex 32`)
AUTH_REFRESH_HASH_SECRET=
# REQUIRED: set a strong random value (e.g. `openssl rand -hex 32`)
PRINT_OTP_HASH_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Rate limiting
# ──────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_MAX_REQUESTS=240
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=40
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX_REQUESTS=12
RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_AI_MAX_REQUESTS=20
RATE_LIMIT_MAX_BUCKETS=20000
