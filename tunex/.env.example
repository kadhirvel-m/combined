# ============================================================
#  TuNeX – Environment Configuration Template
#  Copy this file to .env and fill in your own values.
#  NEVER commit the filled-in .env file to source control.
# ============================================================

# ----- Supabase -------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...
SUPABASE_BUCKET=storage

# ----- AI / LLM -------------------------------------------------
OPENAI_API_KEY=sk-...your-openai-key...
GEMINI_API_KEY=AIza...your-gemini-key...
OPENROUTER_API_KEY=sk-or-v1-...your-openrouter-key...
LLM_MODEL=gpt-4o-mini

# ----- Search ---------------------------------------------------
SERPAPI_API_KEY=...your-serpapi-key...

# ----- YouTube --------------------------------------------------
YOUTUBE_API_KEY=AIza...your-youtube-api-key...

# ----- JWT / Auth -----------------------------------------------
# IMPORTANT: Use a dedicated, randomly-generated secret here.
# Do NOT reuse your Supabase service_role key as the JWT secret.
# Generate one with: openssl rand -hex 32
JWT_SECRET=...generate-with-openssl-rand-hex-32...
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- App --------------------------------------------------
APP_DEBUG=false
